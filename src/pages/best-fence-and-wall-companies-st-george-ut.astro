---
// List-intent guide. Mini-profiles use ONLY what each company's own website
// states (fetched 2026-09-26), phrased as "its site says" -- never our claim
// (compliance.md rules 1/4/6). No ratings, no rankings, no licensing or
// insurance claims repeated. Listed alphabetically. ItemList names only
// entities described in the visible copy; type is Organization, never
// LocalBusiness/AggregateRating/Review.
import GuideLayout from '../components/layout/GuideLayout.astro';
import { itemListSchema } from '../lib/schema';

const path = '/best-fence-and-wall-companies-st-george-ut/';

const companies = [
  {
    name: 'Kirklands Fence & Garden',
