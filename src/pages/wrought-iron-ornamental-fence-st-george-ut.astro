const faq = [
  {
    question: 'How much does a wrought iron or ornamental fence cost in St. George?',
    answer: `As of ${COST_AS_OF}, an ornamental or wrought-iron style fence runs about ${iron.range} per linear foot installed, based on HomeAdvisor's national published range; custom scrollwork, heavier pickets and gates push it higher. No St. George fence company publishes ornamental prices, so treat that as a bracket for comparing written quotes.`,
  },
  {
    question: 'Is it real wrought iron, steel, or aluminum?',
    answer: 'Almost always steel or aluminum. True hand-forged wrought iron is rare in residential work; "wrought iron fence" in a quote usually means welded steel pickets, and "ornamental" often means aluminum. Ask the company to name the metal, the picket and rail sizes, and the finish.',
  },
  {
    question: 'Steel or aluminum for a St. George yard?',
    answer: 'Steel is heavier, stiffer and harder to bend or climb, and it rusts wherever the finish is broken. Aluminum does not rust, weighs less, and suits pool and decorative runs, but it dents more easily. In dry heat both last well if the finish is good and sprinklers stay off the fence line.',
  },
  {
    question: 'Can an ornamental fence go in a St. George front yard?',
    answer: 'Often, yes. Under St. George City Code §10-18-1, most zones cap front-yard fences at 4 feet, and within 10 feet behind the sidewalk only fences that are at least 50 percent open are allowed. An open picket fence can meet that rule where a solid panel cannot. Any fence in a front setback needs a permit under §10-18-5, and your HOA may have its own rules.',
  },
  {
    question: 'Is an ornamental fence a good pool fence?',
    answer: 'It is a common choice, but pool barriers have their own rules on height, gaps between pickets, climbable rails and self-closing, self-latching gates. Read the pool fence guide and confirm the current rule with the city before you order a pool run.',
  },
];

const metals = [
  { icon: 'fence', title: 'Welded steel ("wrought iron")', text: 'The heavy, rigid option and what most quotes mean by wrought iron. Strong against impact and hard to climb; it depends entirely on its finish to keep rust out.' },
  { icon: 'frame', title: 'Aluminum ("ornamental")', text: 'Lighter and rust-free, sold in standard picket styles and colors. Easier to install on a slope and common around pools; thinner sections bend more easily than steel.' },
  { icon: 'scroll', title: 'Custom and decorative work', text: 'Scrollwork, finials, arched tops and custom gates are where the price climbs above the standard range. They are also where quotes differ most, so ask for a drawing.' },
  { icon: 'blocks', title: 'Iron on a block wall', text: 'A common St. George look: ornamental panels set on top of or between block columns. Price the masonry and the metal as separate lines.' },
];

const desertSpec = [
  { icon: 'sun', title: 'Finish rated for sun', text: 'Ask for a powder-coated finish (or primer plus powder coat on steel) rather than paint alone, and ask how the company handles touch-up after installation cuts and welds.' },
  { icon: 'drop', title: 'Keep sprinklers off the metal', text: 'Daily spray followed by a hot afternoon is where rust starts on steel and where mineral spots build up on any finish. Aim the irrigation away from the fence line.' },
  { icon: 'blocks', title: 'Posts set in concrete, with caps', text: 'Posts set in concrete and capped so they do not fill with water. On steel, the base of the post is where rust ends a fence.' },
  { icon: 'shield', title: 'Gates on heavy posts and good hinges', text: 'A metal gate is heavy. Gate posts should be stouter than line posts, with adjustable hinges and a latch suited to how the gate is used.' },
  { icon: 'ruler', title: 'Slope handled on purpose', text: 'Many lots here slope. Ask whether panels will be stepped or racked to follow the grade, and how gaps under the bottom rail will be kept even.' },
];

const compareSteps = [
  { icon: 'ruler', title: 'Same footage, height and style on every quote', text: 'Get linear footage, height, picket spacing and style in writing, so you are comparing the same fence.' },
  { icon: 'fence', title: 'Metal, gauge and picket size named', text: 'Steel or aluminum, the picket and rail dimensions, and the post size. A quote that just says "wrought iron" leaves the biggest variable open.' },
  { icon: 'sun', title: 'Finish and warranty in writing', text: 'Powder coat or paint, how field cuts are sealed, and what the finish warranty covers.' },
  { icon: 'doc', title: 'Gates as separate lines', text: 'Each walk and drive gate priced separately, with hinge and latch type, and any automation quoted on its own.' },
  { icon: 'house', title: 'HOA and permit handling', text: 'Who submits the HOA application, and who pulls the city permit if the fence touches a front setback.' },
