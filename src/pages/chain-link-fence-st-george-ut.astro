const mesh = [
  { icon: 'fence', title: 'Galvanized steel', text: 'Zinc-coated wire and framework, the standard silver chain-link. Lowest cost, long life in dry air, and the most utilitarian look. Fine for side yards, pet runs, and larger lots.' },
  { icon: 'frame', title: 'Vinyl-coated (black, green, brown)', text: 'Galvanized wire with a bonded polymer coating over it. Costs more, disappears visually against trees and dark landscaping, and is the version most HOAs that allow chain-link specify. Black is the common St. George choice.' },
  { icon: 'ruler', title: 'Gauge and mesh size', text: 'Residential mesh is usually 11 or 11.5 gauge with a 2-inch diamond; 9 gauge is heavier, stiffer, and harder to climb or bend. A quote that does not name the gauge leaves the biggest material variable open.' },
  { icon: 'blocks', title: 'Framework and fittings', text: 'Terminal posts, line posts, top rail, tension wire, bands, and caps. Heavier-wall posts and a bottom tension wire are what keep the mesh tight and the fence from sagging over time.' },
