const desertSpec = [
  { icon: 'sun', title: 'Coating that stands up to sun', text: 'Galvanized steel is largely indifferent to dry heat. The polymer on coated mesh is not: ask for a UV-stabilized, fused-and-bonded coating rather than a thin extruded sleeve that can crack and chalk after a few summers.' },
  { icon: 'blocks', title: 'Posts in concrete, caps on every post', text: 'Chain-link fails at the posts first. Terminal and gate posts set in concrete, line posts at consistent spacing, and a cap on every post so the hollow pipe does not fill with irrigation water and rust from the inside.' },
  { icon: 'wrench', title: 'Bottom tension wire or bottom rail', text: 'Without one, the mesh lifts at the bottom, pets push under it, and wind flexes it until the ties loosen. A bottom tension wire is standard; a bottom rail is the stiffer upgrade.' },
  { icon: 'drop', title: 'Keep sprinklers off the fence line', text: 'The one wet spot on a desert lot is the irrigation along the fence. Mesh that is sprayed daily and bakes dry every afternoon is where rust shows first, even on galvanized wire.' },
  { icon: 'flat', title: 'Size posts for slats before adding them', text: 'Open mesh sheds wind; a slatted panel catches it. If privacy slats are in the plan, say so before the posts go in so the company can set heavier posts and deeper footings.' },
  { icon: 'shield', title: 'Gate posts heavier than line posts', text: 'Gates take the load and the abuse. Gate posts should be a larger diameter than the line posts, set deeper, with adjustable hinges so a sagging gate can be re-hung instead of rebuilt.' },
];

const uses = [
  { icon: 'house', title: 'Side and rear yards', text: 'The standard use: a boundary and pet containment at the lowest price per foot, where privacy is not the goal or a block wall already provides it on the other sides.' },
  { icon: 'fence', title: 'Larger lots and acreage', text: 'On the bigger lots in Washington County, chain-link is often the only material that makes a full perimeter affordable. The county guide covers the outlying communities.' },
  { icon: 'scroll', title: 'Front yards under the open-fence rule', text: 'Within 10 feet behind the sidewalk, St. George only allows fences that are at least 50 percent open. Bare chain-link qualifies; a 4-foot coated fence is a practical answer where a picket is not wanted.' },
  { icon: 'poolfence', title: 'Pool enclosures, with care', text: 'Chain-link is climbable, and pool-barrier rules address climbability, mesh size, and gate hardware. Read the pool fence guide and confirm the current rule with the city before choosing it for a pool.' },
