---
// Phase 4 shell for supporting pages (contact, thank-you, 404, legal, how
// matching works, service-area hub). Same header band as GuideLayout but no
// "Quick answer" box, and an optional "last reviewed" line for legal pages.
// Schema: BaseLayout adds Organization / WebSite / WebPage / BreadcrumbList;
// pages pass extra nodes (umbrella Service where the page describes the
// service). No LocalBusiness / Review / AggregateRating. The third-party
// disclosure sentence is NOT rendered here -- it lives once, in the footer.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  h1: string;
  lede?: string;
  reviewed?: string;
  reviewedLabel?: string;
  noindex?: boolean;
  quoteHref?: string;
  schemaNodes?: object[];
  mainEntityId?: string;
}
const {
  title,
  description,
  path,
  eyebrow,
  h1,
  lede,
  reviewed,
  reviewedLabel,
  noindex = false,
  quoteHref = '/contact/#lead-form',
  schemaNodes = [],
  mainEntityId,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  quoteHref={quoteHref}
  noindex={noindex}
  schemaNodes={schemaNodes}
  mainEntityId={mainEntityId}
>
  <section class="border-b border-tint-line bg-tint">
    <div class="section">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 font-display text-fl-3xl font-bold tracking-tight text-ink">{h1}</h1>
      {lede && <p class="mt-4 max-w-prose text-fl-lg text-muted">{lede}</p>}
      {reviewed && (
        <p class="mt-3 text-fl-sm text-muted">
          Last reviewed <time datetime={reviewed}>{reviewedLabel ?? reviewed}</time>
        </p>
      )}
    </div>
  </section>

  <article class="section">
    <div class="sgfw-prose">
      <slot />
    </div>
  </article>

  <slot name="after" />
</BaseLayout>
