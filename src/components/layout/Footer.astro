---
// Third-party disclosure (compliance.md rule 3) rendered once, plainly, in
// natural language -- never repeated elsewhere on the page, never in the
// hero/trust bar/next to a CTA. Pulled from site-config.ts's single source
// of truth. Phase 4 (2026-09-26): every link below resolves; the spoke
// links removed in Phase 3 (retaining-wall cost, license compare, service
// areas) are back now that those pages exist. Phase 6 (2026-09-27): links get
// py-1 (24px tap targets, WCAG 2.5.8) and the bottom block gets !pb-28 below sm (important: .section is unlayered CSS and beats plain utilities)
// so the fixed mobile StickyCTA bar never covers the copyright line.
import { site } from '../../lib/site-config';
const year = new Date().getFullYear();
---

<footer class="border-t-4 border-t-brass bg-river-dark text-paper">
  <div class="section grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-fl-lg font-bold">{site.brandName}</p>
      <p class="mt-2 text-fl-sm text-tint">{site.serviceArea.cities.join(', ')} &middot; {site.serviceArea.county}</p>
      <ul class="mt-3 space-y-1 text-fl-sm">
        <li><a href="/fence-installation-washington-ut/" class="inline-block py-1 hover:underline">Washington, UT fence rules</a></li>
        <li><a href="/fence-installation-hurricane-ut/" class="inline-block py-1 hover:underline">Hurricane fence rules</a></li>
        <li><a href="/fence-contractor-ivins-ut/" class="inline-block py-1 hover:underline">Ivins fence rules</a></li>
        <li><a href="/fence-installation-santa-clara-ut/" class="inline-block py-1 hover:underline">Santa Clara fence rules</a></li>
      </ul>
      {site.phone.href ? (
        <a href={site.phone.href} class="btn-phone-standalone mt-4">Call {site.phone.display}</a>
      ) : (
        <p class="mt-4 text-fl-sm text-tint">Phone line coming soon.</p>
      )}
    </div>

    <div>
      <h3 class="text-fl-sm font-semibold uppercase tracking-wide">Fences &amp; Walls</h3>
      <ul class="mt-3 space-y-1 text-fl-sm">
        <li><a href="/fence-installation-st-george-ut/" class="inline-block py-1 hover:underline">Fence Installation</a></li>
        <li><a href="/fence-repair-st-george-ut/" class="inline-block py-1 hover:underline">Fence Repair</a></li>
        <li><a href="/block-wall-installation-st-george-ut/" class="inline-block py-1 hover:underline">Block &amp; CMU Walls</a></li>
        <li><a href="/pool-fence-and-gate-st-george-ut/" class="inline-block py-1 hover:underline">Pool Fences &amp; Gates</a></li>
        <li><a href="/cmu-block-wall-vs-wood-fence-st-george-ut/" class="inline-block py-1 hover:underline">Block Wall vs Wood Fence</a></li>
        <li><a href="/washington-county-fence-service-areas/" class="inline-block py-1 hover:underline">Service Areas</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-fl-sm font-semibold uppercase tracking-wide">Cost, Permits &amp; Guides</h3>
      <ul class="mt-3 space-y-1 text-fl-sm">
        <li><a href="/fence-and-block-wall-cost-st-george-ut/" class="inline-block py-1 hover:underline">Fence &amp; Block Wall Cost</a></li>
        <li><a href="/retaining-wall-cost-st-george-ut/" class="inline-block py-1 hover:underline">Retaining Wall Cost</a></li>
        <li><a href="/fence-permit-st-george-ut/" class="inline-block py-1 hover:underline">Fence &amp; Wall Permits</a></li>
        <li><a href="/hoa-fence-requirements-st-george-ut/" class="inline-block py-1 hover:underline">HOA Fence Requirements</a></li>
        <li><a href="/best-fence-and-wall-companies-st-george-ut/" class="inline-block py-1 hover:underline">Best Fence &amp; Wall Companies</a></li>
        <li><a href="/licensed-fence-contractor-compare-st-george-ut/" class="inline-block py-1 hover:underline">Check a Contractor License</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-fl-sm font-semibold uppercase tracking-wide">Company</h3>
      <ul class="mt-3 space-y-1 text-fl-sm">
        <li><a href="/about/" class="inline-block py-1 hover:underline">About</a></li>
        <li><a href="/how-fence-and-wall-matching-works/" class="inline-block py-1 hover:underline">How Matching Works</a></li>
        <li><a href="/contact/" class="inline-block py-1 hover:underline">Contact</a></li>
        <li><a href="/terms-of-service/" class="inline-block py-1 hover:underline">Terms</a></li>
        <li><a href="/privacy-policy/" class="inline-block py-1 hover:underline">Privacy Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="section border-t border-white/10 !pb-28 pt-6 text-fl-sm text-tint sm:!pb-12 lg:!pb-16">
    <p>{site.disclosure}</p>
    <p class="mt-3">&copy; {year} {site.brandName}. All rights reserved. Operated by {site.legalEntity}.</p>
  </div>
</footer>
