---
// v1.30 default: new builds ship a hero. Shape follows the st-george-hvac
// reference: kicker -> headline -> byline/lede -> dual CTA -> service-area
// line. The unit directly below it (SuitabilityWorksheet) carries the
// structural differentiation, not this component.
//
// Photo (Phase 4, 2026-09-26): Pexels 22147447, a desert trail and red rock
// above the St. George, UT valley (Pexels license). Replaced the reused
// split-face CMU texture that was also live on the Yuma and East Valley
// sites. Free-stock STOPGAP: Adobe Stock credits were still exhausted on
// 2026-09-26 (per-image price shown, no credits) -- swap for a licensed
// Adobe Stock St. George residential/wall image once credits reset. A place
// photo, not a job photo, so it never implies "our work" (compliance.md
// rule 6). Alt text describes the scene only.
import { site } from '../../lib/site-config';
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/st-george-red-rock-desert-trail.webp';

interface Props {
  quoteHref?: string;
}
const { quoteHref = site.defaultQuoteHref } = Astro.props;
---

<section class="sgfw-hero border-b border-tint-line bg-tint">
  <div class="section grid items-center gap-8 lg:grid-cols-[3fr_2fr]">
    <div>
      <p class="eyebrow">Fence &amp; Block Wall &mdash; St. George &amp; Washington County</p>
      <h1 class="mt-3 font-display text-fl-3xl font-bold tracking-tight text-ink">
        Building a Fence or Block Wall in St. George? Start With the Permit, the HOA, and the Right Local Pro
      </h1>
      <p class="mt-4 max-w-prose text-fl-lg text-muted">
        Cost ranges, city permit rules, and pool-fence and HOA questions answered first &mdash; then
        we connect you with an independent local fence or block-wall company that handles your job.
        No cost, no obligation.
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        {site.phone.href ? (
          <a href={site.phone.href} class="btn-phone" data-analytics="phone_click">Call {site.phone.display}</a>
        ) : (
          <span class="btn border border-dashed border-tint-line text-muted">Phone line coming soon</span>
        )}
        <a href={quoteHref} class="btn-quote">Get Matched With a Pro</a>
      </div>

      <p class="mt-4 text-fl-sm text-muted">Serving {site.serviceArea.cities.join(', ')} &middot; {site.serviceArea.county}</p>
    </div>

    <!-- brass "cap course" rule + hard block shadow frame the photo like a wall cap -->
    <div class="border-t-8 border-t-brass shadow-block">
      <Image
        src={heroImg}
        alt="Gravel trail through red rock and desert shrubs above the St. George, Utah valley under a cloudy sky"
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-[4/3] w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
