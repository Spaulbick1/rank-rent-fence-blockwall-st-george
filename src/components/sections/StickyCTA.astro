---
// Mobile sticky bottom bar -- every page it renders on must have a valid
// quoteHref (thank-you/404/legal pages pass one explicitly rather than a
// dead anchor). Phone-primary/quote-secondary hierarchy (v1.17).
import { site } from '../../lib/site-config';

interface Props {
  quoteHref?: string;
}
const { quoteHref = site.defaultQuoteHref } = Astro.props;
---

<aside aria-label="Call or get matched" class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-tint-line bg-paper p-3 shadow-lift sm:hidden">
  {site.phone.href ? (
    <a href={site.phone.href} class="btn-phone flex-1" data-analytics="phone_click">Call Now</a>
  ) : (
    <span class="flex-1 rounded-blk border border-tint-line px-5 py-3 text-center text-fl-sm text-muted">Phone live at launch</span>
  )}
  <a href={quoteHref} class="btn-quote flex-1">Get Matched</a>
</aside>
